{
  "name": "quarry",
  "version": "2.0.0",
  "description": "Narrative engine for personal knowledge vault",
  "main": "code/muse_app.js",
  "scripts": {
    "migrate": "node --no-warnings code/migrate.js",
    "index": "node --no-warnings code/indexer.js --diff",
    "nuggetize": "node --no-warnings code/nuggetizer.js",
    "tagger": "node --no-warnings code/tagger.js",
    "dedupe": "node --no-warnings code/dedupe.js",
    "wordplay": "node --no-warnings code/wordplay.js",
    "muse": "node --no-warnings code/muse_view.js",
    "muse:app": "node --no-warnings code/muse_app.js",
    "ops": "node --no-warnings code/muse_ops.js",
    "muse:report": "node --no-warnings code/muse_scratch.js",
    "heuristics": "node --no-warnings packs/quiz/tools/heuristics_build.js",
    "heuristics:check": "node --no-warnings packs/quiz/tools/heuristics_build.js --check",
    "datamap": "node --no-warnings code/data_map.js",
    "datamap:check": "node --no-warnings code/data_map.js --check",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "jsonrepair": "^3.15.0",
    "llm-model-resolver": "^1.5.2",
    "pluralize": "^8.0.0",
    "yaml": "^2.9.1"
  }
}
